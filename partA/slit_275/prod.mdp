; shared settings, copied into every stage below
cutoff-scheme   = Verlet
nstlist         = 20
coulombtype     = PME
rcoulomb        = 1.2
vdwtype         = PME          ; LJ-PME: exact for geometric mixing, no DispCorr needed in the slit
rvdw            = 1.2
lj-pme-comb-rule = geometric
fourierspacing  = 0.12
constraints     = all-bonds    ; CH4 C-H and CO2 C=O; water uses SETTLE
constraint-algorithm = lincs
lincs-order     = 6
integrator      = md
dt              = 0.002
nsteps          = 10000      ; 20 ns
;nsteps          = 10000000      ; 20 ns
tcoupl          = V-rescale
tc-grps         = System
tau-t           = 1.0
ref-t           = 275
pcoupl          = no            ; NVT at the average NPT box (pick the frame closest to <Lz>)
refcoord-scaling = com
comm-mode       = Linear
nstxout-compressed = 500        ; 1 ps
compressed-x-grps  = Fluid      ; index group without graphene, saves ~20% disk
nstenergy       = 500
