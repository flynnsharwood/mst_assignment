; shared settings, copied into every stage below
cutoff-scheme   = Verlet
nstlist         = 20
coulombtype     = PME
rcoulomb        = 1.2
vdwtype         = PME          ; LJ-PME: exact for geometric mixing, no DispCorr needed in the slit
rvdw            = 1.2
lj-pme-comb-rule = geometric
fourierspacing  = 0.12
constraints     = all-bonds    ; CH4 C-H and CO2 C=O; water uses SETTLE
constraint-algorithm = lincs
lincs-order     = 6
integrator      = md
dt              = 0.002
nsteps          = 50000       ; 5 ns
;nsteps          = 2500000       ; 5 ns
tcoupl          = V-rescale
tc-grps         = System
tau-t           = 1.0
ref-t           = 275
pcoupl          = C-rescale
pcoupltype      = semiisotropic ; xy fixed by the graphene lattice, z breathes
tau-p           = 5.0
ref-p           = 100 100       ; bar (10 MPa)
compressibility = 0 4.5e-5
refcoord-scaling = com
nstxout-compressed = 5000
nstenergy       = 500
